# RENAME THIS FILE TO .ENV BEFORE RUNNING
#OPENAI_API_KEY= Paste your open api key here
#CF_TURNSTILE_KEY = Paste your cf turnstile secret key here to use the website
#CF_TURNSTILE_SITE_KEY = Paste your cf turnstile site key here
#MODEL_NAME = the model to use for date extraction, e.g. "gpt-4o"

# Optional
#DEV_MODE = 1 to skip Turnstile when CF_TURNSTILE_KEY is not set (local testing only)
#TRUSTED_PROXIES = comma-separated networks allowed to set CF-Connecting-IP (default: localhost and private networks)
#BIND_HOST = address the server listens on (default: 0.0.0.0)
#UPLOADS_PER_HOUR = uploads allowed per visitor IP per hour (default: 20)
#MAX_FILES_PER_UPLOAD = (default: 100)
#MAX_CONCURRENT_BATCHES = batches processed at once; others wait in a queue (default: 2)
#WORKERS_PER_BATCH = images processed in parallel within a batch (default: 3)
#MAX_QUEUED_BATCHES = uploads allowed to wait for processing before new ones are refused (default: 10)
#MAX_DATE_READS_PER_BATCH = OpenAI date reads per upload; the rest are saved undated (default: 300)
#MAX_IMAGE_PIXELS = largest image accepted, in pixels (default: 100000000)
#MIN_FREE_DISK_GB = refuse uploads when free disk space drops below this (default: 5)
